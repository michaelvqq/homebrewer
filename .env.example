# Local (supabase start prints these) or from your hosted project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: encrypts users' API keys at rest (openssl rand -base64 32)
KEY_ENCRYPTION_SECRET=

# Optional shared demo keys, used when a signed-in user has not saved their own key.
SHARED_ANTHROPIC_API_KEY=
SHARED_OPENAI_API_KEY=
SHARED_GOOGLE_API_KEY=
# Optional shared demo keys, used when a user hasn't saved their own
SHARED_ANTHROPIC_API_KEY=
SHARED_OPENAI_API_KEY=
SHARED_GOOGLE_API_KEY=
